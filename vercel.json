{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://app.cal.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://api.imagekit.io https://upload.imagekit.io https://unpkg.com https://api.github.com https://github.com https://cal.com https://app.cal.com https://www.google-analytics.com https://region1.google-analytics.com; frame-src 'self' https://cal.com https://app.cal.com; worker-src 'self' blob:;"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/prerendered/home.html" },
    { "source": "/about", "destination": "/prerendered/about.html" },
    { "source": "/pricing", "destination": "/prerendered/pricing.html" },
    { "source": "/booking", "destination": "/prerendered/booking.html" },
    { "source": "/contact", "destination": "/prerendered/contact.html" },
    { "source": "/areas", "destination": "/prerendered/areas.html" },
    { "source": "/faq", "destination": "/prerendered/faq.html" },
    { "source": "/photographer-stoke-on-trent", "destination": "/prerendered/photographer-stoke-on-trent.html" },
    { "source": "/family-photographer-stoke-on-trent", "destination": "/prerendered/family-photographer-stoke-on-trent.html" },
    { "source": "/event-photographer-manchester", "destination": "/prerendered/event-photographer-manchester.html" },
    { "source": "/event-photographer-birmingham", "destination": "/prerendered/event-photographer-birmingham.html" },
    { "source": "/collections/studio-portraits", "destination": "/prerendered/collections-studio-portraits.html" },
    { "source": "/collections/family-sessions", "destination": "/prerendered/collections-family-sessions.html" },
    { "source": "/collections/event-photography", "destination": "/prerendered/collections-event-photography.html" },
    {
      "source": "/((?!api(?:/|$)|admin(?:/|$)|assets(?:/|$)|images(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
