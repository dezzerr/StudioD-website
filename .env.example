# ============================================
# StudioD - Environment Configuration
# ============================================

# --------------------------------------------
# ImageKit Configuration (Required)
# --------------------------------------------
# Get your credentials from https://imagekit.io/dashboard
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_ENDPOINT
VITE_IMAGEKIT_PUBLIC_KEY=YOUR_PUBLIC_KEY
IMAGEKIT_PRIVATE_KEY=YOUR_PRIVATE_KEY

# --------------------------------------------
# Vercel Configuration
# --------------------------------------------
VITE_SITE_URL=https://studiod.com

# --------------------------------------------
# Contact Form Settings
# --------------------------------------------
# The Vercel API route validates and logs submissions until an email provider is configured.
CONTACT_EMAIL=hello@studiod.com

# --------------------------------------------
# Cal.com Booking Configuration (Optional)
# --------------------------------------------
# Public booking links only. Keep Cal.com API keys and webhook secrets server-side.
VITE_CAL_EVENT_PORTRAIT_URL=https://cal.com/your-account/portrait-photography
VITE_CAL_EVENT_EVENT_URL=https://cal.com/your-account/event-photography
VITE_CAL_EVENT_WEDDING_URL=https://cal.com/your-account/wedding-photography
VITE_CAL_EVENT_ENGAGEMENT_URL=https://cal.com/your-account/engagement-photography

# --------------------------------------------
# CMS / GitHub OAuth Configuration
# --------------------------------------------
GITHUB_REPO=dezzerr/StudioD-website
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret
STUDIO_ADMIN_SESSION_SECRET=your-long-random-session-secret

# --------------------------------------------
# Analytics (Optional)
# --------------------------------------------
# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# or Plausible
VITE_PLAUSIBLE_DOMAIN=studiod.com

# --------------------------------------------
# Development Settings
# --------------------------------------------
# Set to 'true' to disable image optimization in dev
VITE_DISABLE_IMAGE_OPTIMIZATION=false
